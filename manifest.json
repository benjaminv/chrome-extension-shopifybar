{
  "manifest_version": 3,
  "name": "ShopifyBar",
  "version": "0.1.1",
  "description": "Always know which Shopify theme you are viewing - live or preview - even when Shopify's own preview bar is hidden. Hide the preview bar safely without losing track of where you are.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ShopifyBar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/hide-css.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
